@model homeWork_54.Models.TodoTask

@{
    ViewData["Title"] = "Детали задачи";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-secondary mb-4 px-3">
    <div class="navbar-nav">
        <a class="nav-link text-white" asp-action="Index">Все задачи</a>
        <a class="nav-link text-white" asp-action="Create">Добавить задачу</a>
    </div>
</nav>

<div class="border p-4 shadow-sm bg-white">
    <h4>@Model.Title</h4>
    <hr />

    <div class="row">
        <div class="col-md-4 border-end">
            <p>
                <strong>Статус:</strong> 
                @(Model.Status == homeWork_54.Models.TodoStatus.New ? "Новая" :
                  Model.Status == homeWork_54.Models.TodoStatus.Opened ? "Открыта" : "Закрыта")
            </p>
            <p>
                <strong>Приоритет:</strong> 
                @if (Model.Priority == homeWork_54.Models.TaskPriority.High)
                {
                    <span class="text-danger fw-bold">Высокий</span>
                }
                else if (Model.Priority == homeWork_54.Models.TaskPriority.Medium)
                {
                    <span class="text-primary fw-bold">Средний</span>
                }
                else
                {
                    <span class="text-success fw-bold">Низкий</span>
                }
            </p>
            <p><strong>Номер:</strong> @Model.Id</p>
            <p><strong>Исполнитель:</strong> @Model.Assignee</p>
            <p><strong>Дата создания:</strong> @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</p>

            @if (Model.Status == homeWork_54.Models.TodoStatus.Closed && Model.ClosedDate.HasValue)
            {
                <p><strong>Дата закрытия:</strong> @Model.ClosedDate.Value.ToString("dd.MM.yyyy HH:mm")</p>
            }
        </div>

        <div class="col-md-8">
            <h5>Описание задачи</h5>
            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Описание отсутствует." : Model.Description)</p>
        </div>
    </div>

    <hr />
    <div class="d-flex gap-2">
        @if (Model.Status == homeWork_54.Models.TodoStatus.New)
        {
            <form asp-action="Open" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary">Открыть</button>
            </form>
        }
        else if (Model.Status == homeWork_54.Models.TodoStatus.Opened)
        {
            <form asp-action="Close" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary">Закрыть</button>
            </form>
        }

        @if (Model.Status != homeWork_54.Models.TodoStatus.Opened)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary">Удалить</button>
            </form>
        }

        <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>